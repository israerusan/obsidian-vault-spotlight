{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES2020"]
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.d.mts"]
}
